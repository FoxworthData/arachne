# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*build/
*dist/
*.egg-info/
*.spec

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# macOS files
.DS_Store

# Environment and sensitive files
.env
env_save.txt

# Log and output files
*.log
*.html
*.csv

# Local Claude Code config (per-user, not team-shared)
.mcp.json
.claude/settings.local.json
.claude/sessions/

# HAR captures contain raw HTTP request/response pairs from real browser
# sessions and may include cookies, tokens, and other session data. Keep
# them out of version control; re-capture as needed.
*.har
